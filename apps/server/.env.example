PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Web frontend dev origin (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_campaign
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_for_hmac_sha256

# Email Provider (resend | ses)
APP_EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
AWS_REGION=us-east-1

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend OAuth2 Redirect URL
FRONTEND_OAUTH2_REDIRECT_URL=http://localhost:5173/oauth2/redirect
