{
  "name": "email-campaign",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "catalog:",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "dev": "turbo -F web dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "cd apps/server && ./mvnw spring-boot:run",
    "check:server": "cd apps/server && ./mvnw package",
    "test:server": "cd apps/server && ./mvnw test",
    "lint:eslint": "eslint .",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "test": "bun run --filter web test"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14"
    }
  }
}
